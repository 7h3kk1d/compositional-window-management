{
  "name": "compositional-window-management",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/demo/vite.config.ts",
    "build": "tsc -b && vite build --config apps/demo/vite.config.ts",
    "lint": "oxlint",
    "preview": "vite preview --config apps/demo/vite.config.ts",
    "test": "vitest run",
    "build:element": "vite build --config packages/element/vite.config.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
